PORT=3000
# Public URL of this panel (must be https in production). Used inside the embed snippet.
BASE_URL=http://localhost:3000
# Contact for push services (mailto: or https:)
VAPID_SUBJECT=mailto:you@example.com
# Optional. Auto-generated and stored in the database if left empty.
JWT_SECRET=
# Set to false after you create your admin account to block new signups.
ALLOW_SIGNUP=true
# Where the SQLite database lives
DATA_DIR=./data
